# Copy this file to .env and add your OpenAI API key.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-4o

# Default instrument and data settings. CLI flags override these.
SYMBOL=AAPL
PERIOD=5d
INTERVAL=5m
POLL_INTERVAL_SECONDS=60
DURATION_MINUTES=60
NEWS_LIMIT=10

# Paper-trading risk controls only. No live orders are sent.
MIN_CONFIDENCE=0.70
INITIAL_CASH=10000
MAX_POSITION_FRACTION=0.10
STOP_LOSS_FRACTION=0.03
TAKE_PROFIT_FRACTION=0.06
