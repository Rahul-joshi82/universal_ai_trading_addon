# =====================================================================
# Universal AI Trading Add-on for Delta Exchange India
# Environment Configuration Template (.env.example)
#
# COPY TO .env BEFORE RUNNING:
#   Copy-Item .env.example .env (Windows PowerShell)
#   cp .env.example .env        (Linux/macOS)
#
# NEVER COMMIT YOUR .env FILE OR REAL API SECRETS TO VERSION CONTROL.
# =====================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Core Trading Mode
# PAPER_TRADING=true: Safe local simulation mode. No broker orders will be sent.
# PAPER_TRADING=false: Enables Delta Exchange India integration (requires credentials).
PAPER_TRADING=true

# Exchange Target Environment (testnet or production)
# TESTNET: https://cdn-ind.testnet.deltaex.org | wss://socket-ind.testnet.deltaex.org
# PRODUCTION: https://api.india.delta.exchange  | wss://socket.india.delta.exchange
DELTA_ENV=testnet

# Delta Exchange India DEMO/TESTNET API Credentials
# Obtain these from your official Delta India demo account.
DELTA_TESTNET_API_KEY=
DELTA_TESTNET_API_SECRET=

# Explicit Testnet Order Placement Gate
# Default is false. Set to true ONLY when you explicitly intend to place demo orders.
DELTA_ENABLE_TESTNET_ORDERS=false

# Production Safety Lock
# Real-money production trading is hard-locked by default.
ALLOW_PRODUCTION_TRADING=false

# Optional custom REST & WebSocket Overrides (leave empty for automatic defaults)
DELTA_REST_URL=
DELTA_WS_URL=

# Quantitative Pre-Trade Risk Limits
MAX_ORDER_QUANTITY=5
MAX_POSITION_QUANTITY=10
MAX_NOTIONAL_EXPOSURE=250000.0
MAX_DAILY_LOSS=1000.0
MAX_OPEN_ORDERS=20
MAX_SPREAD_PCT=0.005
MAX_STALE_SECONDS=10.0
CONSECUTIVE_ERROR_LIMIT=5

# Database Persistence Configuration
DATABASE_URL=sqlite:///./trading_addon.db

# Optional AI Advisory Services (Strictly advisory; models never place orders)
AI_ANALYSIS_ENABLED=true
OPENAI_API_KEY=
GEMINI_API_KEY=

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
